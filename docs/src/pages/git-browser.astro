---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: "Git Browser", template: "doc" }}>
<div class="git-browser">
    <header class="page-header">
        <h1>Git Browser</h1>
        <p>Browse all source files with syntax highlighting</p>
    </header>
    
    <div class="git-browser-toolbar">
        <div class="repo-info">
            <span class="branch">main</span>
            <a href="https://github.com/dominic84p/vide-de" target="_blank" rel="noopener" class="github-link">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                View on GitHub
            </a>
        </div>
        <div class="search-box">
            <input type="text" id="file-search" placeholder="Filter files..." aria-label="Filter files">
        </div>
    </div>
    
    <div class="git-browser-main">
        <aside class="file-tree" id="file-tree">
            <div class="tree-loading">Loading repository...</div>
        </aside>
        <main class="file-view" id="file-view">
            <div class="view-placeholder">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                </svg>
                <p>Select a file from the tree to view its contents</p>
            </div>
        </main>
    </div>
</div>
</StarlightPage>

<script type="module" src="/scripts/git-browser.js"></script>

<style>
.git-browser .page-header {
    margin-bottom: 1.5rem;
}

.git-browser .page-header h1 {
    margin: 0 0 0.5rem;
}

.git-browser .page-header p {
    margin: 0;
    color: var(--sl-color-gray-6);
}

.git-browser-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: var(--sl-color-gray-1);
    border-radius: 8px;
    margin-bottom: 1rem;
    border: 1px solid var(--sl-color-gray-2);
}

@media (prefers-color-scheme: dark) {
    .git-browser-toolbar {
        background: var(--sl-color-blue-dark-1);
        border-color: var(--sl-color-blue-dark-3);
    }
}

.repo-info {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.branch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
}

@media (prefers-color-scheme: dark) {
    .branch {
        background: var(--sl-color-accent-low-dark);
        color: var(--sl-color-accent-high-dark);
    }
}

.github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-gray-6);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.15s;
}

.github-link:hover {
    color: var(--sl-color-accent-high);
}

.search-box input {
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 6px;
    background: var(--sl-color-white);
    color: var(--sl-color-gray-9);
    font-size: 0.875rem;
    width: 250px;
    transition: border-color 0.15s, box-shadow 0.15s;
}

@media (prefers-color-scheme: dark) {
    .search-box input {
        background: var(--sl-color-blue-dark-2);
        border-color: var(--sl-color-blue-dark-4);
        color: var(--sl-color-white);
    }
}

.search-box input:focus {
    outline: none;
    border-color: var(--sl-color-accent-high);
    box-shadow: 0 0 0 3px var(--sl-color-accent-low);
}

.git-browser-main {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 1rem;
    height: calc(100vh - 300px);
    min-height: 500px;
}

@media (max-width: 900px) {
    .git-browser-main {
        grid-template-columns: 1fr;
    }
}

.file-tree {
    background: var(--sl-color-gray-1);
    border: 1px solid var(--sl-color-gray-2);
    border-radius: 8px;
    overflow: auto;
    max-height: 100%;
}

@media (prefers-color-scheme: dark) {
    .file-tree {
        background: var(--sl-color-blue-dark-1);
        border-color: var(--sl-color-blue-dark-3);
    }
}

.tree-loading {
    padding: 2rem;
    text-align: center;
    color: var(--sl-color-gray-5);
}

.tree-folder {
    cursor: pointer;
    user-select: none;
}

.tree-folder > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    transition: background 0.15s;
}

.tree-folder > summary:hover {
    background: var(--sl-color-accent-low);
}

@media (prefers-color-scheme: dark) {
    .tree-folder > summary:hover {
        background: var(--sl-color-accent-low-dark);
    }
}

.tree-folder > summary:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: -2px;
}

.tree-file {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem 0.375rem 1.5rem;
    border-radius: 4px;
    font-size: 0.875rem;
    color: var(--sl-color-gray-7);
    text-decoration: none;
    transition: all 0.15s;
    cursor: pointer;
}

@media (prefers-color-scheme: dark) {
    .tree-file {
        color: var(--sl-color-gray-3);
    }
}

.tree-file:hover,
.tree-file.selected {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
}

@media (prefers-color-scheme: dark) {
    .tree-file:hover,
    .tree-file.selected {
        background: var(--sl-color-accent-low-dark);
        color: var(--sl-color-accent-high-dark);
    }
}

.tree-file:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: -2px;
}

.file-view {
    background: var(--sl-color-gray-1);
    border: 1px solid var(--sl-color-gray-2);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

@media (prefers-color-scheme: dark) {
    .file-view {
        background: var(--sl-color-blue-dark-1);
        border-color: var(--sl-color-blue-dark-3);
    }
}

.view-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-5);
    text-align: center;
    padding: 2rem;
}

.view-placeholder svg {
    margin-bottom: 1rem;
    opacity: 0.5;
}

.file-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-2);
    background: var(--sl-color-white);
}

@media (prefers-color-scheme: dark) {
    .file-header {
        background: var(--sl-color-blue-dark-2);
        border-color: var(--sl-color-blue-dark-3);
    }
}

.file-path {
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
    color: var(--sl-color-gray-6);
}

@media (prefers-color-scheme: dark) {
    .file-path {
        color: var(--sl-color-gray-4);
    }
}

.file-actions {
    display: flex;
    gap: 0.5rem;
}

.file-actions button {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--sl-color-gray-3);
    background: var(--sl-color-white);
    border-radius: 4px;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.15s;
}

@media (prefers-color-scheme: dark) {
    .file-actions button {
        background: var(--sl-color-blue-dark-2);
        border-color: var(--sl-color-blue-dark-4);
    }
}

.file-actions button:hover {
    background: var(--sl-color-gray-1);
    border-color: var(--sl-color-gray-4);
}

@media (prefers-color-scheme: dark) {
    .file-actions button:hover {
        background: var(--sl-color-blue-dark-3);
        border-color: var(--sl-color-blue-dark-4);
    }
}

.file-content {
    flex: 1;
    overflow: auto;
    padding: 1rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--sl-color-gray-8);
}

@media (prefers-color-scheme: dark) {
    .file-content {
        color: var(--sl-color-gray-2);
    }
}

.file-content pre {
    margin: 0;
    background: transparent;
    border: none;
    padding: 0;
}

.file-content code {
    background: transparent;
    padding: 0;
}

.file-content .line {
    display: flex;
    min-height: 1.6em;
}

.file-content .line-number {
    display: inline-block;
    width: 3.5rem;
    padding-right: 1rem;
    text-align: right;
    color: var(--sl-color-gray-4);
    user-select: none;
    border-right: 1px solid var(--sl-color-gray-2);
    margin-right: 1rem;
    flex-shrink: 0;
}

@media (prefers-color-scheme: dark) {
    .file-content .line-number {
        color: var(--sl-color-gray-5);
        border-color: var(--sl-color-blue-dark-3);
    }
}

.file-content .line-content {
    white-space: pre-wrap;
    word-break: break-word;
}

/* Syntax highlighting tokens (basic) */
.token.comment { color: #6a737d; }
.token.keyword { color: #d73a49; }
.token.function { color: #6f42c1; }
.token.string { color: #032f62; }
.token.number { color: #005cc5; }
.token.operator { color: #d73a49; }
.token.punctuation { color: #24292e; }
.token.class-name { color: #22863a; }
.token.constant { color: #005cc5; }
.token.attribute { color: #22863a; }
.token.boolean { color: #005cc5; }

@media (prefers-color-scheme: dark) {
    .token.comment { color: #8b949e; }
    .token.keyword { color: #ff7b72; }
    .token.function { color: #d2a8ff; }
    .token.string { color: #a5d6ff; }
    .token.number { color: #79c0ff; }
    .token.operator { color: #ff7b72; }
    .token.punctuation { color: #e6edf3; }
    .token.class-name { color: #7ee787; }
    .token.constant { color: #79c0ff; }
    .token.attribute { color: #7ee787; }
    .token.boolean { color: #79c0ff; }
}
</style>