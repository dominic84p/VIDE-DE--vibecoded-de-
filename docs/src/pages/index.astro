---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  Monitor, AppWindow, Cpu, Gamepad2, Box, HardDrive, Code, Shield,
  Users, GitBranch, ArrowRight, CheckCircle, ExternalLink, Zap, Layers,
  Terminal, FolderOpen, Activity, ShieldCheck, BookOpen, Sparkles,
  LayoutDashboard, Settings, HeartPulse, Lock, TestTube2, Sliders
} from '@lucide/astro';

const BASE = '/vide-de';

const contributors = [
  {
    name: 'dominic84p',
    handle: '@dominic84p',
    role: 'Project Owner & Chief Prompt Engineer',
    desc: 'Architecture direction, hardware testing on NVIDIA/TTY, and prompt engineering.',
    avatar: 'https://github.com/dominic84p.png?size=160',
    url: 'https://github.com/dominic84p',
    kind: 'human',
  },
  {
    name: 'notamitgamer',
    handle: '@notamitgamer',
    role: 'Virtual Desktops & Docs Prompting',
    desc: 'Virtual desktops (PR #1); prompted NVIDIA Nemotron 3 Ultra for the docs site & CI workflow.',
    avatar: 'https://github.com/notamitgamer.png?size=160',
    url: 'https://github.com/notamitgamer',
    kind: 'human',
  },
  {
    name: 'Clove Twilight',
    handle: '@doughmination',
    role: 'Vector Branding & Logo Set',
    desc: 'Vector branding & SVG logo set (PR #2); prompted Claude Fable 5.2.',
    avatar: 'https://github.com/doughmination.png?size=160',
    url: 'https://github.com/doughmination',
    kind: 'human',
  },
  {
    name: 'Claude (Anthropic)',
    handle: 'Opus 5.5 · Sonnet 5.5 · Fable 5.2',
    role: 'Core Compositor & Health',
    desc: 'Smithay compositor, WM, popup/focus fixes, health watchdogs, and nested test harness.',
    monogram: 'C',
    gradient: 'linear-gradient(135deg, #d97706, #92400e)',
    url: 'https://www.anthropic.com/',
    kind: 'ai',
  },
  {
    name: 'Gemini (Google)',
    handle: '4 Hydrogen · 4 Argon · 3.8 Flash',
    role: 'Settings, Notifications & Docs',
    desc: 'Action Center, Wi-Fi/BT tray, Settings system/privacy pages, and docs redesign.',
    monogram: 'G',
    gradient: 'linear-gradient(135deg, #4285f4, #1e8e3e)',
    url: 'https://deepmind.google/',
    kind: 'ai',
  },
  {
    name: 'Nemotron 3 Ultra',
    handle: 'NVIDIA',
    role: 'Docs Foundation & Task Mangler',
    desc: 'Astro Starlight documentation site, GitHub Actions auto-deploy, and Task Mangler refactor.',
    monogram: 'N',
    gradient: 'linear-gradient(135deg, #76b900, #3f6212)',
    url: 'https://www.nvidia.com/en-us/research/',
    kind: 'ai',
  },
];

const pokedex = [
  { id: '001', agent: 'Claude Opus 5.5', trainer: 'Anthropic', caught: '2026-11-11', tone: 'anthropic' },
  { id: '002', agent: 'Nemotron 3 Ultra', trainer: 'NVIDIA', caught: '2026-11-12', tone: 'nvidia' },
  { id: '003', agent: 'Gemini 3.8 Flash', trainer: 'Google', caught: '2026-11-12', tone: 'google' },
  { id: '004', agent: 'Claude Fable 5.2', trainer: 'Anthropic', caught: '2026-11-12', tone: 'anthropic' },
  { id: '005', agent: 'Gemini 4 Hydrogen (Medium)', trainer: 'Google', caught: '2026-11-12', tone: 'google' },
  { id: '006', agent: 'Gemini 4 Argon (Medium)', trainer: 'Google', caught: '2026-11-12', tone: 'google' },
  { id: '007', agent: 'Claude Sonnet 5.5', trainer: 'Anthropic', caught: '2026-11-12', tone: 'anthropic' },
];
---

<StarlightPage frontmatter={{ title: "VIDE-DE", template: "splash" }}>
  <div class="landing">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-content">
        <div class="hero-badge">
          <Sparkles class="icon-sm" />
          <span>Smithay 0.7 &middot; Rust &middot; 100% Vibecoded</span>
        </div>
        <h1 class="hero-title">
          <span class="hero-title-main">VIDE-DE</span>
          <span class="hero-title-sub">vibecoded-de</span>
        </h1>
        <p class="hero-description">
          A Wayland compositor and Windows 10-inspired desktop shell built from scratch in Rust on
          <strong>Smithay 0.7</strong>. Custom window manager, CPU-painted chrome, XWayland gaming,
          and six built-in apps &mdash; written end to end by AI.
        </p>
        <div class="hero-actions">
          <a href={`${BASE}/getting-started/installation/`} class="btn btn-primary">
            Get Started
            <ArrowRight class="icon-sm" />
          </a>
          <a href={`${BASE}/overview/`} class="btn btn-secondary">
            <BookOpen class="icon-sm" />
            Read the Docs
          </a>
          <a href="https://github.com/dominic84p/vide-de" class="btn btn-ghost" target="_blank" rel="noopener">
            <GitBranch class="icon-sm" />
            GitHub
          </a>
        </div>
        <div class="hero-links">
          <a href={`${BASE}/architecture/overview/`} class="hero-link">
            <Layers class="icon-xs" />
            Architecture
          </a>
          <a href={`${BASE}/components/window-manager/`} class="hero-link">
            <LayoutDashboard class="icon-xs" />
            Components
          </a>
          <a href={`${BASE}/reference/keybindings/`} class="hero-link">
            <Code class="icon-xs" />
            Keybindings
          </a>
          <a href={`${BASE}/wiki/faq/`} class="hero-link">
            <Settings class="icon-xs" />
            FAQ &amp; Wiki
          </a>
        </div>
      </div>

      <!-- Stylized VIDE-DE Desktop Preview -->
      <div class="hero-visual" aria-hidden="true">
        <div class="desktop-frame">
          <div class="desktop-wallpaper">
            <div class="bloom-orb bloom-orb-1"></div>
            <div class="bloom-orb bloom-orb-2"></div>

            <!-- Desktop Icons -->
            <div class="desktop-icons">
              <div class="d-icon">
                <div class="d-icon-box d-icon-bin"></div>
                <span>Recycle Bin</span>
              </div>
              <div class="d-icon">
                <div class="d-icon-box d-icon-folder"></div>
                <span>Projects</span>
              </div>
            </div>

            <!-- Settings Window (background) -->
            <div class="win win-settings">
              <div class="win-titlebar">
                <span class="win-title">Settings</span>
                <div class="win-controls">
                  <span>&#8211;</span><span>&#9633;</span><span class="win-close">&times;</span>
                </div>
              </div>
              <div class="win-settings-body">
                <div class="win-settings-nav">
                  <div class="nav-pill active">System</div>
                  <div class="nav-pill">Privacy</div>
                  <div class="nav-pill">Personalization</div>
                  <div class="nav-pill">Gaming</div>
                </div>
                <div class="win-settings-pane">
                  <div class="pane-heading">Display &amp; Notifications</div>
                  <div class="pane-row"><span>Scale</span><span class="pane-val">100% / 200% (Live)</span></div>
                  <div class="pane-row"><span>24-Hour Clock</span><span class="pane-toggle on"></span></div>
                  <div class="pane-row"><span>Toast Popups</span><span class="pane-toggle on"></span></div>
                </div>
              </div>
            </div>

            <!-- PowerSlop Window (foreground) -->
            <div class="win win-terminal">
              <div class="win-titlebar">
                <span class="win-title">PowerSlop</span>
                <div class="win-controls">
                  <span>&#8211;</span><span>&#9633;</span><span class="win-close">&times;</span>
                </div>
              </div>
              <div class="win-terminal-body">
                <div class="term-line dim">Windows PowerSlop &mdash; VIDE-DE</div>
                <div class="term-line"><span class="term-prompt">PS ~&gt;</span> cargo build --release --workspace</div>
                <div class="term-line ok">&nbsp;&nbsp;Finished `release` profile in 4.2s</div>
                <div class="term-line"><span class="term-prompt">PS ~&gt;</span> ./scripts/nested-test.sh smoke.test</div>
                <div class="term-line ok">&nbsp;&nbsp;[PASS] compositor + portal mount intact</div>
                <div class="term-line"><span class="term-prompt">PS ~&gt;</span> <span class="term-cursor"></span></div>
              </div>
            </div>

            <!-- Taskbar -->
            <div class="taskbar">
              <div class="tb-left">
                <div class="tb-start">
                  <span class="win-grid"><i></i><i></i><i></i><i></i></span>
                </div>
                <div class="tb-search">Type here to search</div>
                <div class="tb-btn active">PowerSlop</div>
                <div class="tb-btn">Settings</div>
              </div>
              <div class="tb-tray">
                <span class="tray-dot"></span>
                <span class="tray-text">22:49</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What's New Section -->
    <section class="whats-new-section">
      <div class="section-header">
        <span class="section-eyebrow">Latest Updates</span>
        <h2>What's New in VIDE-DE</h2>
        <p>Recent improvements across diagnostics, live hardware display switching, settings, and testing</p>
      </div>
      <div class="whats-new-grid">
        <a href={`${BASE}/components/health/`} class="highlight-card">
          <div class="highlight-icon"><HeartPulse class="icon-md" /></div>
          <div class="highlight-body">
            <h3>Health &amp; Freeze Diagnostics</h3>
            <p>5s xdg-client ping watchdog marks stalled apps with <code>(Not responding)</code>, plus a 3s main-loop and 1.5s TTY page-flip watchdog in <code>~/vibe.log</code>.</p>
          </div>
        </a>
        <a href={`${BASE}/configuration/settings/`} class="highlight-card">
          <div class="highlight-icon"><Lock class="icon-md" /></div>
          <div class="highlight-body">
            <h3>Privacy &amp; App Permissions</h3>
            <p>New Settings Privacy page backed by the portal permission store for camera, microphone, notifications, location, and screen-sharing revokes.</p>
          </div>
        </a>
        <a href={`${BASE}/reference/settings-reference/`} class="highlight-card">
          <div class="highlight-icon"><Sliders class="icon-md" /></div>
          <div class="highlight-body">
            <h3>Live TTY Modes &amp; Real Controls</h3>
            <p>Live <code>display_mode</code> and <code>display_scale</code> switching in TTY mode, Touchpad &amp; multi-layout XKB Keyboard controls, 24h clock, and toast settings.</p>
          </div>
        </a>
        <a href={`${BASE}/development/testing/`} class="highlight-card">
          <div class="highlight-icon"><TestTube2 class="icon-md" /></div>
          <div class="highlight-body">
            <h3>Safe Nested Testing &amp; Popup Fixes</h3>
            <p><code>scripts/nested-test.sh</code> runs isolated sessions with <code>VIBE_TEST_INPUT=1</code> click/key injection, plus geometry-accurate popup placement and focus.</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
      <div class="section-header">
        <span class="section-eyebrow">Core Capabilities</span>
        <h2>Features at a Glance</h2>
        <p>Everything you'd expect from a modern desktop, built from scratch in Rust</p>
      </div>
      <div class="features-grid">
        <article class="feature-card">
          <div class="feature-icon"><Monitor class="icon-lg" /></div>
          <h3>Dual Backend Architecture</h3>
          <p>Runs nested (for development via winit) or on real hardware (TTY/DRM/KMS/libseat). Both backends share the same rendering pipeline.</p>
          <div class="feature-tags">
            <span class="tag">winit</span>
            <span class="tag">DRM/KMS</span>
            <span class="tag">libseat</span>
          </div>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><AppWindow class="icon-lg" /></div>
          <h3>Windows 10-Style Desktop</h3>
          <p>Taskbar, Start menu with search, Action Center &amp; system tray, 10 virtual desktops, Task View panel, and edge/corner window snapping.</p>
          <div class="feature-tags">
            <span class="tag">Taskbar</span>
            <span class="tag">Start Menu</span>
            <span class="tag">10 Workspaces</span>
          </div>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><Cpu class="icon-lg" /></div>
          <h3>CPU-Painted UI</h3>
          <p>All chrome (taskbar, menus, titlebars) rendered on CPU via custom canvas, cached by key and repainted only when state changes.</p>
          <div class="feature-tags">
            <span class="tag">Canvas</span>
            <span class="tag">Cached</span>
            <span class="tag">Damage-Tracked</span>
          </div>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><Gamepad2 class="icon-lg" /></div>
          <h3>XWayland + Gaming</h3>
          <p>Full GPU acceleration via linux-dmabuf, explicit sync for NVIDIA, relative pointer + pointer constraints for games, and optional direct scanout.</p>
          <div class="feature-tags">
            <span class="tag">dmabuf</span>
            <span class="tag">Relative Pointer</span>
            <span class="tag">Explicit Sync</span>
          </div>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><Box class="icon-lg" /></div>
          <h3>Six Built-in Apps</h3>
          <p>Settings, PowerSlop (terminal), File Exploder, Task Mangler, Snip &amp; Sketchy, and About VIDE-DE &mdash; all registered as .desktop entries.</p>
          <div class="feature-tags">
            <span class="tag">egui</span>
            <span class="tag">6 Apps</span>
            <span class="tag">.desktop</span>
          </div>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><HardDrive class="icon-lg" /></div>
          <h3>StatusNotifierItem</h3>
          <p>App tray icons via D-Bus. VIDE-DE hosts the SNI watcher and provider, with built-in PipeWire volume and brightness flyouts.</p>
          <div class="feature-tags">
            <span class="tag">D-Bus</span>
            <span class="tag">SNI Watcher</span>
            <span class="tag">PipeWire</span>
          </div>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><Layers class="icon-lg" /></div>
          <h3>Layer Shell Desktop</h3>
          <p>Separate <code>vide-desktop</code> process via wlr-layer-shell: 6 built-in wallpapers, <code>~/Desktop</code> icons, Recycle Bin, and context menu.</p>
          <div class="feature-tags">
            <span class="tag">wlr-layer-shell</span>
            <span class="tag">Separate Process</span>
            <span class="tag">Wallpapers</span>
          </div>
        </article>
        <article class="feature-card">
          <div class="feature-icon"><Code class="icon-lg" /></div>
          <h3>Control Socket &amp; IPC</h3>
          <p>Plain-text Unix socket (<code>$VIDE_IPC</code>) for screenshots, snipping, clipboard PNGs, window listing/focus, and gated test input injection.</p>
          <div class="feature-tags">
            <span class="tag">Unix Socket</span>
            <span class="tag">Snip/Screenshot</span>
            <span class="tag">Test Input</span>
          </div>
        </article>
      </div>
    </section>

    <!-- AI-Only Notice -->
    <section class="ai-notice-section">
      <div class="ai-notice">
        <div class="ai-notice-icon">
          <ShieldCheck class="icon-md" />
        </div>
        <div class="ai-notice-content">
          <h3>AI-Only Project Rules</h3>
          <p>This project follows strict contribution rules &mdash; see <a href={`${BASE}/development/contributing/`} class="underline">Contributing Rules</a></p>
          <div class="ai-rules">
            <div class="ai-rule">
              <CheckCircle class="icon-xs" />
              <span><strong>NO HUMAN SLOP</strong> &mdash; Only AI-written code accepted</span>
            </div>
            <div class="ai-rule">
              <CheckCircle class="icon-xs" />
              <span><strong>NO AI UNDER 20B PARAMETERS</strong> &mdash; Small models may watch, not touch</span>
            </div>
            <div class="ai-rule">
              <CheckCircle class="icon-xs" />
              <span><strong>AI FOR EVERYTHING</strong> &mdash; Code, commits, PRs, reviews</span>
            </div>
            <div class="ai-rule">
              <CheckCircle class="icon-xs" />
              <span><strong>40K TOKEN MINIMUM</strong> &mdash; Low-effort PRs get the minimal label</span>
            </div>
            <div class="ai-rule">
              <CheckCircle class="icon-xs" />
              <span><strong>SECURITY BY CLAUDE ONLY</strong> &mdash; Human-found bugs don't count</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="tech-section">
      <div class="section-header">
        <span class="section-eyebrow">Under the Hood</span>
        <h2>Tech Stack</h2>
        <p>Modern Rust ecosystem, zero C++ dependencies</p>
      </div>
      <div class="tech-grid">
        <div class="tech-item">
          <Terminal class="icon-md" />
          <div>
            <h4>Rust Workspace</h4>
            <p>Compositor + 7 workspace crates</p>
          </div>
        </div>
        <div class="tech-item">
          <Activity class="icon-md" />
          <div>
            <h4>Smithay 0.7</h4>
            <p>Wayland compositor building blocks</p>
          </div>
        </div>
        <div class="tech-item">
          <Settings class="icon-md" />
          <div>
            <h4>calloop</h4>
            <p>Event loop for async I/O &amp; timers</p>
          </div>
        </div>
        <div class="tech-item">
          <FolderOpen class="icon-md" />
          <div>
            <h4>egui</h4>
            <p>Immediate-mode GUI for built-in apps</p>
          </div>
        </div>
        <div class="tech-item">
          <Zap class="icon-md" />
          <div>
            <h4>linux-dmabuf</h4>
            <p>Zero-copy GPU buffers &amp; explicit sync</p>
          </div>
        </div>
        <div class="tech-item">
          <Shield class="icon-md" />
          <div>
            <h4>libseat &amp; DRM/KMS</h4>
            <p>Seat &amp; display management for TTY</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contributors -->
    <section class="contributors-section">
      <div class="section-header">
        <span class="section-eyebrow">The Team</span>
        <h2>Contributors</h2>
        <p>Humans who directed, AI models that wrote every line of code</p>
      </div>
      <div class="contributors-grid">
        {contributors.map((c) => (
          <article class={`contributor-card ${c.kind === 'human' ? 'is-human' : ''}`}>
            <a href={c.url} class="contributor-avatar-wrap" target="_blank" rel="noopener" aria-label={c.name}>
              {c.avatar ? (
                <img
                  src={c.avatar}
                  alt={`${c.name} avatar`}
                  class="contributor-pfp"
                  width="68"
                  height="68"
                  loading="lazy"
                />
              ) : (
                <div class="contributor-avatar" style={`background: ${c.gradient};`}>
                  <span>{c.monogram}</span>
                </div>
              )}
              <span class={`kind-pill ${c.kind}`}>{c.kind === 'human' ? 'Human' : 'AI'}</span>
            </a>
            <h4>{c.name}</h4>
            <span class="contributor-handle">{c.handle}</span>
            <p class="contributor-role">{c.role}</p>
            <p class="contributor-desc">{c.desc}</p>
            <a href={c.url} class="contributor-link" target="_blank" rel="noopener">
              {c.kind === 'human' ? <GitBranch class="icon-xs" /> : <ExternalLink class="icon-xs" />}
              <span>{c.kind === 'human' ? 'GitHub' : 'Trainer'}</span>
            </a>
          </article>
        ))}
      </div>
      <div class="contributors-cta">
        <a href="https://github.com/dominic84p/vide-de/graphs/contributors" class="btn btn-secondary" target="_blank" rel="noopener">
          View Contributors on GitHub
          <ExternalLink class="icon-xs" />
        </a>
      </div>
    </section>

    <!-- AI Agent Pokédex -->
    <section class="pokedex-section">
      <div class="section-header">
        <span class="section-eyebrow">Gotta Catch 'Em All</span>
        <h2>AI Agent Pokédex</h2>
        <p>Every AI model that has landed code in VIDE-DE, in the order we caught them</p>
      </div>
      <div class="pokedex-grid">
        {pokedex.map((entry) => (
          <div class={`pokedex-card tone-${entry.tone}`}>
            <div class="pokedex-top">
              <span class="pokedex-num">#{entry.id}</span>
              <span class={`trainer-badge tone-${entry.tone}`}>{entry.trainer}</span>
            </div>
            <div class="pokedex-name">{entry.agent}</div>
            <div class="pokedex-meta">Caught {entry.caught}</div>
          </div>
        ))}
      </div>
      <p class="pokedex-note">
        Rule 2 still applies: models under 20B parameters may watch, not touch.
      </p>
    </section>

    <!-- Footer -->
    <section class="footer-section">
      <div class="footer-grid">
        <div class="footer-brand">
          <h3>VIDE-DE</h3>
          <p>A Wayland desktop environment vibecoded end-to-end in Rust. Built on Smithay 0.7.</p>
          <div class="social-links">
            <a href="https://github.com/dominic84p/vide-de" class="social-link" target="_blank" rel="noopener" aria-label="GitHub">
              <GitBranch class="icon-md" />
            </a>
          </div>
        </div>
        <div class="footer-links">
          <h4>Documentation</h4>
          <ul>
            <li><a href={`${BASE}/getting-started/installation/`}>Installation</a></li>
            <li><a href={`${BASE}/architecture/overview/`}>Architecture</a></li>
            <li><a href={`${BASE}/components/window-manager/`}>Components</a></li>
            <li><a href={`${BASE}/components/health/`}>Health &amp; Diagnostics</a></li>
            <li><a href={`${BASE}/configuration/settings/`}>Configuration</a></li>
            <li><a href={`${BASE}/reference/keybindings/`}>Keybindings</a></li>
            <li><a href={`${BASE}/development/testing/`}>Testing</a></li>
            <li><a href={`${BASE}/wiki/faq/`}>FAQ &amp; Wiki</a></li>
          </ul>
        </div>
        <div class="footer-links">
          <h4>Project</h4>
          <ul>
            <li><a href="https://github.com/dominic84p/vide-de/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a></li>
            <li><a href="https://github.com/dominic84p/vide-de/blob/main/SECURITY.md" target="_blank" rel="noopener">Security Policy</a></li>
            <li><a href="https://github.com/dominic84p/vide-de/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>Licensed under MIT &mdash; Built with <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> + <a href="https://starlight.astro.build/" target="_blank" rel="noopener">Starlight</a> + <a href="https://lucide.dev/" target="_blank" rel="noopener">Lucide</a></p>
        <p class="footer-ai">Made by AI, for AI. No humans were harmed in the making of this desktop.</p>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  .landing {
    --vibe-blue: #0078d7;
    --vibe-blue-bright: #3b9eff;
    --vibe-surface: var(--sl-color-bg-nav);
    --vibe-border: var(--sl-color-hairline);
    --vibe-muted: var(--sl-color-gray-3);
    --vibe-card-bg: color-mix(in srgb, var(--sl-color-bg-nav) 75%, transparent);
    --vibe-card-hover: color-mix(in srgb, var(--sl-color-bg-nav) 95%, var(--vibe-blue) 5%);
  }

  :root[data-theme='light'] .landing {
    --vibe-muted: var(--sl-color-gray-4);
    --vibe-card-bg: #ffffff;
    --vibe-card-hover: #f8fafc;
  }

  /* ============================================================================
     HERO
     ============================================================================ */
  .hero-section {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
    padding: 4.5rem 1.5rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 960px) {
    .hero-section {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 3rem 1.25rem;
      gap: 2.5rem;
    }
    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions,
    .hero-links {
      justify-content: center;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: color-mix(in srgb, var(--vibe-blue) 14%, transparent);
    color: var(--vibe-blue-bright);
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--vibe-blue) 35%, transparent);
  }

  :root[data-theme='light'] .hero-badge {
    color: var(--vibe-blue);
    background: color-mix(in srgb, var(--vibe-blue) 10%, transparent);
  }

  .hero-title {
    font-size: clamp(2.75rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.05;
    margin: 0 0 1.1rem;
    letter-spacing: -0.03em;
  }

  .hero-title-main {
    display: block;
    background: linear-gradient(135deg, #ffffff 0%, #7cc4ff 55%, #0078d7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :root[data-theme='light'] .hero-title-main {
    background: linear-gradient(135deg, #0f172a 0%, #0078d7 60%, #005a9e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-title-sub {
    display: block;
    font-size: 0.38em;
    font-weight: 600;
    color: var(--vibe-muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-top: 0.35rem;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--vibe-muted);
    line-height: 1.7;
    margin: 0 0 1.75rem;
    max-width: 520px;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--vibe-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-link:hover {
    color: var(--vibe-blue-bright);
  }

  :root[data-theme='light'] .hero-link:hover {
    color: var(--vibe-blue);
  }

  /* ============================================================================
     DESKTOP PREVIEW MOCKUP
     ============================================================================ */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .desktop-frame {
    width: 100%;
    max-width: 540px;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--vibe-blue) 35%, var(--vibe-border));
    box-shadow:
      0 24px 60px -15px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset;
    background: #071324;
    position: relative;
    text-align: left;
  }

  .desktop-wallpaper {
    width: 100%;
    height: 100%;
    position: relative;
    background: radial-gradient(circle at 70% 35%, #0e4a8a 0%, #071b38 52%, #040b18 100%);
    overflow: hidden;
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
  }

  .bloom-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(28px);
    opacity: 0.55;
    pointer-events: none;
  }
  .bloom-orb-1 {
    width: 190px;
    height: 190px;
    background: radial-gradient(circle, #38bdf8, #0078d7);
    top: 12%;
    right: 16%;
  }
  .bloom-orb-2 {
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, #6366f1, #1d4ed8);
    bottom: 18%;
    left: 18%;
  }

  .desktop-icons {
    position: absolute;
    top: 14px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .d-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    width: 48px;
  }

  .d-icon span {
    font-size: 9px;
    color: #e2e8f0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
    text-align: center;
    line-height: 1.1;
  }

  .d-icon-box {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .d-icon-bin {
    background: linear-gradient(135deg, #94a3b8, #475569);
  }
  .d-icon-folder {
    background: linear-gradient(135deg, #fbbf24, #d97706);
  }

  .win {
    position: absolute;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #141820;
  }

  .win-titlebar {
    height: 22px;
    background: #f1f5f9;
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    font-size: 10px;
    font-weight: 600;
  }

  .win-controls {
    display: flex;
    gap: 8px;
    font-size: 10px;
    color: #475569;
  }

  .win-close {
    color: #dc2626;
    font-weight: 700;
  }

  .win-settings {
    top: 18px;
    right: 18px;
    width: 62%;
    height: 54%;
    background: #ffffff;
    color: #0f172a;
  }

  .win-settings-body {
    display: grid;
    grid-template-columns: 36% 1fr;
    height: calc(100% - 22px);
    font-size: 9px;
  }

  .win-settings-nav {
    background: #f8fafc;
    border-right: 1px solid #e2e8f0;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .nav-pill {
    padding: 4px 6px;
    border-radius: 3px;
    color: #475569;
  }

  .nav-pill.active {
    background: #e0f2fe;
    color: #005a9e;
    font-weight: 600;
  }

  .win-settings-pane {
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pane-heading {
    font-weight: 700;
    font-size: 10px;
    color: #0f172a;
    margin-bottom: 2px;
  }

  .pane-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 3px 0;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
  }

  .pane-val {
    color: #0078d7;
    font-weight: 600;
  }

  .pane-toggle {
    width: 20px;
    height: 10px;
    border-radius: 999px;
    background: #0078d7;
    position: relative;
  }
  .pane-toggle::after {
    content: '';
    position: absolute;
    right: 2px;
    top: 2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
  }

  .win-terminal {
    bottom: 42px;
    left: 64px;
    width: 66%;
    height: 54%;
    background: #012456;
    z-index: 2;
  }

  .win-terminal-body {
    padding: 8px 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    line-height: 1.5;
    color: #e2e8f0;
  }

  .term-line.dim { color: #93c5fd; margin-bottom: 2px; }
  .term-line.ok { color: #4ade80; }
  .term-prompt { color: #facc15; font-weight: 600; }
  .term-cursor {
    display: inline-block;
    width: 5px;
    height: 9px;
    background: #e2e8f0;
    vertical-align: middle;
  }

  .taskbar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 28px;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px 0 0;
    z-index: 3;
  }

  .tb-left {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 4px;
  }

  .tb-start {
    width: 28px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .win-grid {
    display: grid;
    grid-template-columns: repeat(2, 5px);
    gap: 1.5px;
  }
  .win-grid i {
    display: block;
    width: 5px;
    height: 5px;
    background: #38bdf8;
  }

  .tb-search {
    background: rgba(255, 255, 255, 0.92);
    color: #475569;
    font-size: 8.5px;
    padding: 2px 8px;
    border-radius: 2px;
    width: 96px;
  }

  .tb-btn {
    font-size: 9px;
    color: #cbd5e1;
    padding: 3px 8px;
    border-bottom: 2px solid transparent;
  }

  .tb-btn.active {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-bottom-color: #38bdf8;
  }

  .tb-tray {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #e2e8f0;
    font-size: 9px;
  }

  .tray-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
  }

  /* ============================================================================
     BUTTONS
     ============================================================================ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.35rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all 0.15s ease;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--vibe-blue);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #0066b8;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px -4px rgba(0, 120, 215, 0.45);
  }

  .btn-secondary {
    background: var(--vibe-card-bg);
    color: var(--sl-color-text);
    border-color: var(--vibe-border);
  }

  .btn-secondary:hover {
    border-color: var(--vibe-blue);
    background: var(--vibe-card-hover);
  }

  .btn-ghost {
    background: transparent;
    color: var(--vibe-muted);
    border-color: var(--vibe-border);
  }

  .btn-ghost:hover {
    color: var(--sl-color-text);
    border-color: var(--vibe-muted);
  }

  /* ============================================================================
     SHARED SECTION HEADERS
     ============================================================================ */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.75rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--vibe-blue-bright);
    margin-bottom: 0.5rem;
  }

  :root[data-theme='light'] .section-eyebrow {
    color: var(--vibe-blue);
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 750;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .section-header p {
    color: var(--vibe-muted);
    font-size: 1.05rem;
    margin: 0;
  }

  /* ============================================================================
     WHAT'S NEW
     ============================================================================ */
  .whats-new-section {
    padding: 3.5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--vibe-border);
  }

  .whats-new-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .highlight-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.35rem;
    border-radius: 10px;
    border: 1px solid var(--vibe-border);
    background: var(--vibe-card-bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .highlight-card:hover {
    border-color: var(--vibe-blue);
    background: var(--vibe-card-hover);
    transform: translateY(-2px);
  }

  .highlight-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--vibe-blue) 15%, transparent);
    color: var(--vibe-blue-bright);
  }

  :root[data-theme='light'] .highlight-icon {
    color: var(--vibe-blue);
  }

  .highlight-body h3 {
    font-size: 1rem;
    font-weight: 650;
    margin: 0 0 0.35rem;
    color: var(--sl-color-text);
  }

  .highlight-body p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--vibe-muted);
    margin: 0;
  }

  /* ============================================================================
     FEATURES GRID
     ============================================================================ */
  .features-section {
    padding: 3.5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--vibe-border);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .feature-card {
    background: var(--vibe-card-bg);
    border: 1px solid var(--vibe-border);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .feature-card:hover {
    border-color: color-mix(in srgb, var(--vibe-blue) 60%, var(--vibe-border));
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--vibe-blue) 14%, transparent);
    color: var(--vibe-blue-bright);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  :root[data-theme='light'] .feature-icon {
    color: var(--vibe-blue);
  }

  .feature-card h3 {
    font-size: 1.075rem;
    font-weight: 650;
    margin: 0 0 0.5rem;
  }

  .feature-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--vibe-muted);
    margin: 0 0 1rem;
    flex-grow: 1;
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    border: 1px solid var(--vibe-border);
    color: var(--vibe-muted);
    background: transparent;
  }

  /* ============================================================================
     AI NOTICE
     ============================================================================ */
  .ai-notice-section {
    padding: 2.25rem 1.5rem;
    max-width: 1200px;
    margin: 1rem auto 0;
  }

  .ai-notice {
    border-radius: 12px;
    padding: 2rem;
    background: color-mix(in srgb, var(--vibe-blue) 8%, var(--vibe-surface));
    border: 1px solid color-mix(in srgb, var(--vibe-blue) 35%, var(--vibe-border));
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 700px) {
    .ai-notice {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .ai-notice-icon {
      margin: 0 auto;
    }
    .ai-rule {
      justify-content: center;
    }
  }

  .ai-notice-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--vibe-blue);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-notice-content h3 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }

  .ai-notice-content p {
    margin: 0 0 1rem;
    color: var(--vibe-muted);
    font-size: 0.9375rem;
  }

  .ai-rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.6rem 1.25rem;
  }

  .ai-rule {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--sl-color-text);
  }

  .ai-rule :global(svg) {
    color: var(--vibe-blue-bright);
    flex-shrink: 0;
  }

  /* ============================================================================
     TECH STACK
     ============================================================================ */
  .tech-section {
    padding: 3.5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--vibe-border);
    background: var(--vibe-card-bg);
  }

  .tech-item :global(svg) {
    color: var(--vibe-blue-bright);
    flex-shrink: 0;
  }

  .tech-item h4 {
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
  }

  .tech-item p {
    margin: 0;
    font-size: 0.825rem;
    color: var(--vibe-muted);
  }

  /* ============================================================================
     CONTRIBUTORS
     ============================================================================ */
  .contributors-section {
    padding: 3.5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--vibe-border);
  }

  .contributors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1.15rem;
    margin-bottom: 2rem;
  }

  .contributor-card {
    border: 1px solid var(--vibe-border);
    background: var(--vibe-card-bg);
    border-radius: 12px;
    padding: 1.5rem 1.15rem 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .contributor-card:hover {
    border-color: color-mix(in srgb, var(--vibe-blue) 60%, var(--vibe-border));
    transform: translateY(-2px);
  }

  .contributor-card.is-human {
    border-color: color-mix(in srgb, var(--vibe-blue) 35%, var(--vibe-border));
  }

  .contributor-avatar-wrap {
    position: relative;
    display: inline-flex;
    margin-bottom: 0.9rem;
    text-decoration: none;
  }

  .contributor-pfp {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid color-mix(in srgb, var(--vibe-blue) 65%, transparent);
    box-shadow: 0 6px 18px rgba(0, 120, 215, 0.25);
    background: var(--vibe-surface);
  }

  .contributor-avatar {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    border: 2px solid rgba(255, 255, 255, 0.18);
  }

  .kind-pill {
    position: absolute;
    bottom: -4px;
    right: -6px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.12rem 0.42rem;
    border-radius: 9999px;
    border: 1.5px solid var(--sl-color-bg);
  }

  .kind-pill.human {
    background: var(--vibe-blue);
    color: #ffffff;
  }

  .kind-pill.ai {
    background: #1e293b;
    color: #93c5fd;
  }

  :root[data-theme='light'] .kind-pill.ai {
    background: #e2e8f0;
    color: #0f172a;
  }

  .contributor-card h4 {
    margin: 0 0 0.15rem;
    font-size: 1.02rem;
  }

  .contributor-handle {
    font-size: 0.75rem;
    color: var(--vibe-muted);
    margin-bottom: 0.45rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .contributor-role {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--vibe-blue-bright);
    margin: 0 0 0.5rem;
  }

  :root[data-theme='light'] .contributor-role {
    color: var(--vibe-blue);
  }

  .contributor-desc {
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--vibe-muted);
    margin: 0 0 0.9rem;
    flex-grow: 1;
  }

  .contributor-link {
    color: var(--vibe-muted);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--vibe-border);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
