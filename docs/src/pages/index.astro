---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Monitor, AppWindow, Cpu, Gamepad2, Box, HardDrive, Code, Shield, Users, GitBranch, ArrowRight, CheckCircle, ExternalLink, Zap, Layers, Terminal, FolderOpen, Activity, ShieldCheck, BookOpen, Sparkles, LayoutDashboard, Settings, Bug, Moon, Sun } from '@lucide/astro';

const BASE = '/vide-de';
---

<StarlightPage frontmatter={{ title: "VIDE-DE", template: "splash" }}>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-badge">
        <Sparkles class="icon-sm" />
        <span>v0.1.0 — Early but usable</span>
      </div>
      <h1 class="hero-title">
        <span class="hero-title-main">VIDE-DE</span>
        <span class="hero-title-sub">vibecoded-de</span>
      </h1>
      <p class="hero-description">
        A Wayland compositor + desktop shell built on <strong>Smithay 0.7</strong>, written entirely in Rust through AI-assisted "vibecoding". No human-written code accepted.
      </p>
      <div class="hero-actions">
        <a href={`${BASE}/docs/getting-started/installation/`} class="btn btn-primary">
          <ArrowRight class="icon-sm" />
          Get Started
        </a>
        <a href="https://github.com/dominic84p/vide-de" class="btn btn-secondary" target="_blank" rel="noopener">
          <GitBranch class="icon-sm" />
          GitHub Repository
        </a>
      </div>
      <div class="hero-links">
        <a href={`${BASE}/docs/architecture/overview/`} class="hero-link">
          <BookOpen class="icon-xs" />
          Architecture
        </a>
        <a href={`${BASE}/docs/wiki/faq/`} class="hero-link">
          <Settings class="icon-xs" />
          FAQ & Wiki
        </a>
        <a href={`${BASE}/docs/components/window-manager/`} class="hero-link">
          <LayoutDashboard class="icon-xs" />
          Components
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-screenshot-placeholder">
        <Monitor class="icon-xl" />
        <p>Screenshot placeholder — add your own</p>
      </div>
    </div>
  </section>

  <!-- AI-Only Badge -->
  <section class="ai-notice-section">
    <div class="ai-notice">
      <div class="ai-notice-icon">
        <ShieldCheck class="icon-md" />
      </div>
      <div class="ai-notice-content">
        <h3>AI-Only Project</h3>
        <p>This project follows strict contribution rules — see <a href={`${BASE}/docs/development/contributing/`} class="underline">Contributing Rules</a></p>
        <div class="ai-rules">
          <div class="ai-rule">
            <CheckCircle class="icon-xs" />
            <span>NO HUMAN SLOP — Only AI-written code accepted</span>
          </div>
          <div class="ai-rule">
            <CheckCircle class="icon-xs" />
            <span>NO AI UNDER 20B PARAMETERS — Small models may watch, not touch</span>
          </div>
          <div class="ai-rule">
            <CheckCircle class="icon-xs" />
            <span>AI FOR EVERYTHING — Code, commits, PRs, reviews</span>
          </div>
          <div class="ai-rule">
            <CheckCircle class="icon-xs" />
            <span>40K TOKEN MINIMUM — Low-effort PRs get the minimal label</span>
          </div>
          <div class="ai-rule">
            <CheckCircle class="icon-xs" />
            <span>SECURITY BY CLAUDE ONLY — Human-found bugs don't count</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section">
    <div class="section-header">
      <h2>Features at a Glance</h2>
      <p>Everything you'd expect from a modern desktop, built from scratch</p>
    </div>
    <div class="features-grid">
      <article class="feature-card">
        <div class="feature-icon">
          <Monitor class="icon-lg" />
        </div>
        <h3>Dual Backend Architecture</h3>
        <p>Runs nested (for development via winit) or on real hardware (TTY/DRM/KMS/libseat). Both backends share the same rendering pipeline.</p>
        <div class="feature-tags">
          <span class="tag">winit</span>
          <span class="tag">DRM/KMS</span>
          <span class="tag">libseat</span>
        </div>
      </article>
      <article class="feature-card">
        <div class="feature-icon">
          <AppWindow class="icon-lg" />
        </div>
        <h3>Windows 10-Style Desktop</h3>
        <p>Taskbar, Start menu with search, system tray, virtual desktops (10 workspaces), Task View panel, window snapping.</p>
        <div class="feature-tags">
          <span class="tag">Taskbar</span>
          <span class="tag">Start Menu</span>
          <span class="tag">10 Workspaces</span>
        </div>
      </article>
      <article class="feature-card">
        <div class="feature-icon">
          <Cpu class="icon-lg" />
        </div>
        <h3>CPU-Painted UI</h3>
        <p>All chrome (taskbar, menus, titlebars) rendered on CPU via custom canvas, cached by key. Debug builds slow; use release.</p>
        <div class="feature-tags">
          <span class="tag">Canvas</span>
          <span class="tag">Cached</span>
          <span class="tag">GPU Composited</span>
        </div>
      </article>
      <article class="feature-card">
        <div class="feature-icon">
          <Gamepad2 class="icon-lg" />
        </div>
        <h3>XWayland + Gaming</h3>
        <p>Full GPU acceleration via linux-dmabuf. Relative pointer + pointer constraints for games. X11 windows managed natively.</p>
        <div class="feature-tags">
          <span class="tag">dmabuf</span>
          <span class="tag">Relative Pointer</span>
          <span class="tag">X11 Native</span>
        </div>
      </article>
      <article class="feature-card">
        <div class="feature-icon">
          <Box class="icon-lg" />
        </div>
        <h3>Built-in Apps</h3>
        <p>Settings, PowerSlop (terminal), File Exploder, Task Mangler, Snip & Sketchy, About — all registered as .desktop entries.</p>
        <div class="feature-tags">
          <span class="tag">6 Apps</span>
          <span class="tag">egui</span>
          <span class="tag">.desktop</span>
        </div>
      </article>
      <article class="feature-card">
        <div class="feature-icon">
          <HardDrive class="icon-lg" />
        </div>
        <h3>StatusNotifierItem</h3>
        <p>App tray icons via D-Bus. We host the SNI watcher and provide the host. Volume/brightness flyouts built in.</p>
        <div class="feature-tags">
          <span class="tag">D-Bus</span>
          <span class="tag">SNI Watcher</span>
          <span class="tag">Flyouts</span>
        </div>
      </article>
      <article class="feature-card">
        <div class="feature-icon">
          <Layers class="icon-lg" />
        </div>
        <h3>Layer Shell Desktop</h3>
        <p>Separate <code>vide-desktop</code> process via wlr-layer-shell: wallpaper, ~/Desktop icons, Recycle Bin, right-click menu.</p>
        <div class="feature-tags">
          <span class="tag">wlr-layer-shell</span>
          <span class="tag">Separate Process</span>
          <span class="tag">Wallpapers</span>
        </div>
      </article>
      <article class="feature-card">
        <div class="feature-icon">
          <Code class="icon-lg" />
        </div>
        <h3>IPC & Extensibility</h3>
        <p>Control socket (<code>$VIDE_IPC</code>) for screenshots, snipping, clipboard. Extensible protocol for external tools.</p>
        <div class="feature-tags">
          <span class="tag">Unix Socket</span>
          <span class="tag">Snip/Screenshot</span>
          <span class="tag">Clipboard</span>
        </div>
      </article>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="tech-section">
    <div class="section-header">
      <h2>Tech Stack</h2>
      <p>Modern Rust ecosystem, zero C++ dependencies</p>
    </div>
    <div class="tech-grid">
      <div class="tech-item">
        <Terminal class="icon-md" />
        <div>
          <h4>Rust 2021 Edition</h4>
          <p>Memory safety without garbage collection</p>
        </div>
      </div>
      <div class="tech-item">
        <Activity class="icon-md" />
        <div>
          <h4>Smithay 0.7</h4>
          <p>Wayland compositor building blocks</p>
        </div>
      </div>
      <div class="tech-item">
        <Settings class="icon-md" />
        <div>
          <h4>calloop</h4>
          <p>Event loop for async I/O</p>
        </div>
      </div>
      <div class="tech-item">
        <FolderOpen class="icon-md" />
        <div>
          <h4>egui 0.31</h4>
          <p>Immediate mode GUI for built-in apps</p>
        </div>
      </div>
      <div class="tech-item">
        <Zap class="icon-md" />
        <div>
          <h4>ash / wgpu</h4>
          <p>Vulkan & GPU acceleration</p>
        </div>
      </div>
      <div class="tech-item">
        <Shield class="icon-md" />
        <div>
          <h4>libseat</h4>
          <p>Seat management for TTY mode</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contributors -->
  <section class="contributors-section">
    <div class="section-header">
      <h2>Contributors</h2>
      <p>Humans who directed, models that built</p>
    </div>
    <div class="contributors-grid">
      <article class="contributor-card">
        <div class="contributor-avatar" style="background: linear-gradient(135deg, #0078d7, #005a9e);">
          <Users class="icon-lg" />
        </div>
        <h4>dominic84p</h4>
        <p class="contributor-role">Project Owner</p>
        <p class="contributor-desc">Chief prompt engineer, architecture direction</p>
        <a href="https://github.com/dominic84p" class="contributor-link" target="_blank" rel="noopener">
          <GitBranch class="icon-xs" />
        </a>
      </article>
      <article class="contributor-card">
        <div class="contributor-avatar" style="background: linear-gradient(135deg, #76b900, #5a9e00);">
          <Zap class="icon-lg" />
        </div>
        <h4>NVIDIA Nemotron 3 Ultra</h4>
        <p class="contributor-role">Documentation & Workflow</p>
        <p class="contributor-desc">Astro Starlight docs site, GitHub Actions CI, Task Mangler refactor</p>
        <a href="https://www.nvidia.com/en-us/research/" class="contributor-link" target="_blank" rel="noopener">
          <ExternalLink class="icon-xs" />
        </a>
      </article>
      <article class="contributor-card">
        <div class="contributor-avatar" style="background: linear-gradient(135deg, #d97706, #b45309);">
          <Sparkles class="icon-lg" />
        </div>
        <h4>Claude Opus 5.5</h4>
        <p class="contributor-role">Core Compositor</p>
        <p class="contributor-desc">Compositor, shell, window manager, and built-in apps</p>
        <a href="https://www.anthropic.com/" class="contributor-link" target="_blank" rel="noopener">
          <ExternalLink class="icon-xs" />
        </a>
      </article>
      <article class="contributor-card">
        <div class="contributor-avatar" style="background: linear-gradient(135deg, #4285f4, #34a853);">
          <Activity class="icon-lg" />
        </div>
        <h4>Gemini (Google)</h4>
        <p class="contributor-role">Notifications & Settings</p>
        <p class="contributor-desc">Action Center, Wi-Fi/Bluetooth tray, Settings system pages</p>
        <a href="https://deepmind.google/" class="contributor-link" target="_blank" rel="noopener">
          <ExternalLink class="icon-xs" />
        </a>
      </article>
      <article class="contributor-card">
        <div class="contributor-avatar" style="background: linear-gradient(135deg, #8b5cf6, #a855f7);">
          <LayoutDashboard class="icon-lg" />
        </div>
        <h4>notamitgamer</h4>
        <p class="contributor-role">Virtual Desktops</p>
        <p class="contributor-desc">Virtual desktops implementation (PR #1); prompted Nemotron for docs/workflow</p>
        <a href="https://github.com/notamitgamer" class="contributor-link" target="_blank" rel="noopener">
          <GitBranch class="icon-xs" />
        </a>
      </article>
    </div>
    <div class="contributors-cta">
      <a href="/contributors/" class="btn btn-secondary">
        View All Contributors
        <ArrowRight class="icon-xs" />
      </a>
    </div>
  </section>

  <!-- License & Links -->
  <section class="footer-section">
    <div class="footer-grid">
      <div class="footer-brand">
        <h3>VIDE-DE</h3>
        <p>A Wayland desktop environment vibecoded end-to-end in Rust. Built on Smithay.</p>
        <div class="social-links">
          <a href="https://github.com/dominic84p/vide-de" class="social-link" target="_blank" rel="noopener" aria-label="GitHub">
            <GitBranch class="icon-md" />
          </a>
        </div>
      </div>
      <div class="footer-links">
        <h4>Documentation</h4>
        <ul>
          <li><a href={`${BASE}/docs/getting-started/installation/`}>Installation</a></li>
          <li><a href={`${BASE}/docs/architecture/overview/`}>Architecture</a></li>
          <li><a href={`${BASE}/docs/components/window-manager/`}>Components</a></li>
          <li><a href={`${BASE}/docs/configuration/settings/`}>Configuration</a></li>
          <li><a href={`${BASE}/docs/reference/keybindings/`}>Keybindings</a></li>
          <li><a href={`${BASE}/docs/wiki/faq/`}>FAQ & Wiki</a></li>
        </ul>
      </div>
      <div class="footer-links">
        <h4>Legal</h4>
        <ul>
          <li><a href="https://github.com/dominic84p/vide-de/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a></li>
          <li><a href="https://github.com/dominic84p/vide-de/blob/main/SECURITY.md" target="_blank" rel="noopener">Security Policy</a></li>
          <li><a href="https://github.com/dominic84p/vide-de/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Licensed under MIT — Built with <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> + <a href="https://starlight.astro.build/" target="_blank" rel="noopener">Starlight</a> + <a href="https://lucide.dev/" target="_blank" rel="noopener">Lucide</a></p>
      <p class="footer-ai">Made by AI, for AI. No humans were harmed in the making of this desktop.</p>
    </div>
  </section>
</StarlightPage>

<style>
  /* ============================================================================
     HERO SECTION
     ============================================================================ */
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 6rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .hero-section {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 4rem 1.5rem;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--sl-color-blue-1);
    color: var(--sl-color-blue-7);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    border: 1px solid var(--sl-color-blue-2);
  }

  @media (prefers-color-scheme: dark) {
    .hero-badge {
      background: var(--sl-color-blue-dark-1);
      color: var(--sl-color-blue-4);
      border-color: var(--sl-color-blue-dark-3);
    }
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-title-main {
    display: block;
    background: linear-gradient(135deg, var(--sl-color-blue-6), var(--sl-color-blue-4));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-title-sub {
    display: block;
    font-size: 0.6em;
    font-weight: 500;
    color: var(--sl-color-gray-6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (prefers-color-scheme: dark) {
    .hero-title-sub {
      color: var(--sl-color-gray-4);
    }
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--sl-color-gray-6);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 500px;
  }

  @media (prefers-color-scheme: dark) {
    .hero-description {
      color: var(--sl-color-gray-4);
    }
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--sl-color-gray-6);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-link:hover {
    color: var(--sl-color-blue-6);
  }

  @media (prefers-color-scheme: dark) {
    .hero-link {
      color: var(--sl-color-gray-4);
    }
    .hero-link:hover {
      color: var(--sl-color-blue-4);
    }
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-screenshot-placeholder {
    aspect-ratio: 16/9;
    max-width: 500px;
    width: 100%;
    background: var(--sl-color-gray-1);
    border: 1px solid var(--sl-color-gray-2);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--sl-color-gray-5);
    font-size: 1.125rem;
  }

  @media (prefers-color-scheme: dark) {
    .hero-screenshot-placeholder {
      background: var(--sl-color-blue-dark-1);
      border-color: var(--sl-color-blue-dark-3);
      color: var(--sl-color-gray-4);
    }
  }

  .hero-screenshot-placeholder .icon-xl {
    width: 64px;
    height: 64px;
    opacity: 0.5;
  }

  /* ============================================================================
     AI NOTICE
     ============================================================================ */
  .ai-notice-section {
    padding: 2rem;
    background: linear-gradient(135deg, var(--sl-color-blue-1) 0%, var(--sl-color-blue-2) 100%);
    border: 1px solid var(--sl-color-blue-3);
  }

  @media (prefers-color-scheme: dark) {
    .ai-notice-section {
      background: linear-gradient(135deg, var(--sl-color-blue-dark-1) 0%, var(--sl-color-blue-dark-2) 100%);
      border-color: var(--sl-color-blue-dark-3);
    }
  }

  .ai-notice {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 700px) {
    .ai-notice {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .ai-notice-icon {
    width: 64px;
    height: 64px;
    background: var(--sl-color-blue-6);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (prefers-color-scheme: dark) {
    .ai-notice-icon {
      background: var(--sl-color-blue-4);
    }
  }

  .ai-notice-icon .icon-md {
    width: 32px;
    height: 32px;
    color: white;
  }

  .ai-notice-content h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--sl-color-blue-7);
  }

  @media (prefers-color-scheme: dark) {
    .ai-notice-content h3 {
      color: var(--sl-color-blue-3);
    }
  }

  .ai-notice-content p {
    color: var(--sl-color-gray-6);
    margin-bottom: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .ai-notice-content p {
      color: var(--sl-color-gray-4);
    }
  }

  .ai-rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.75rem;
  }

  .ai-rule {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-7);
    background: var(--sl-color-white);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--sl-color-blue-2);
  }

  @media (prefers-color-scheme: dark) {
    .ai-rule {
      background: var(--sl-color-blue-dark-2);
      color: var(--sl-color-gray-3);
      border-color: var(--sl-color-blue-dark-3);
    }
  }

  .ai-rule .icon-xs {
    width: 16px;
    height: 16px;
    color: var(--sl-color-blue-6);
    flex-shrink: 0;
  }

  @media (prefers-color-scheme: dark) {
    .ai-rule .icon-xs {
      color: var(--sl-color-blue-4);
    }
  }

  /* ============================================================================
     FEATURES SECTION
     ============================================================================ */
  .features-section {
    padding: 6rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--sl-color-black);
  }

  @media (prefers-color-scheme: dark) {
    .section-header h2 {
      color: var(--sl-color-white);
    }
  }

  .section-header p {
    font-size: 1.125rem;
    color: var(--sl-color-gray-6);
  }

  @media (prefers-color-scheme: dark) {
    .section-header p {
      color: var(--sl-color-gray-4);
    }
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-2);
    border-radius: 16px;
    padding: 2rem;
    transition: all 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    border-color: var(--sl-color-blue-3);
  }

  @media (prefers-color-scheme: dark) {
    .feature-card {
      background: var(--sl-color-blue-dark-1);
      border-color: var(--sl-color-blue-dark-3);
    }
    .feature-card:hover {
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      border-color: var(--sl-color-blue-4);
    }
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--sl-color-blue-5), var(--sl-color-blue-7));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
