# Regression: the mouse wheel in PowerSlop. Apps that ask for mouse reports (vim, htop) must get
# real wheel events, not arrow keys, and the plain shell must scroll its own history.
run target/release/powerslop -e python3 scripts/nested-tests/pages/wheel-probe.py
expect-window "probe ready" 30
wait 1
move 400 300
scroll -1
expect-window "ESC[<64;" 5
scroll 1
expect-window "ESC[<65;" 5
shot probe
key ctrl+c
run target/release/powerslop -e sh -c 'seq 1 300; sleep 60'
wait 3
move 400 300
shot bottom
scroll -3
wait 0.5
shot history
