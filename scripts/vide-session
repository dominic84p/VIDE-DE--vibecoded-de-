#!/bin/sh
# VIDE-DE Wayland session startup script.
# Launched by SDDM, GDM, greetd, or run directly from a TTY.

export XDG_CURRENT_DESKTOP=VIDE
export XDG_SESSION_DESKTOP=VIDE
export XDG_SESSION_TYPE=wayland

# Standard toolkit wayland backends
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT="wayland"

# Ensure ~/.local/bin and standard paths are in PATH
export PATH="$HOME/.local/bin:$PATH:/usr/local/bin:/usr/bin"

LOG="$HOME/vibe.log"
# Keep the previous session's log: after a crash, that is the one worth reading.
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.old"

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    # Prefer the user's systemd session bus when present so PipeWire/WirePlumber
    # and portals share the same bus; fall back to dbus-run-session otherwise.
    if [ -n "$XDG_RUNTIME_DIR" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
        exec vibe-comp --tty 2> "$LOG"
    else
        exec dbus-run-session -- vibe-comp --tty 2> "$LOG"
    fi
else
    exec vibe-comp --tty 2> "$LOG"
fi
